{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "reference_pose_test.png"
    }
  },
  "2": {
    "class_type": "ImageScale",
    "inputs": {
      "image": ["1", 0],
      "upscale_method": "lanczos",
      "width": 640,
      "height": 960,
      "crop": "disabled"
    }
  },
  "3": {
    "class_type": "OpenposePreprocessor",
    "inputs": {
      "image": ["2", 0],
      "detect_body": "enable",
      "detect_hand": "enable",
      "detect_face": "enable",
      "resolution": 960,
      "scale_stick_for_xinsr_cn": "disable"
    }
  },
  "4": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "proj5_pose_test_preview",
      "images": ["3", 0]
    }
  }
}
